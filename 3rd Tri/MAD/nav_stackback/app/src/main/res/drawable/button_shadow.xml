<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hover / Focus -->
    <item android:state_hovered="true">
        <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:radius="8dp"/>
            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="0dp"
                android:bottom="0dp"/>
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>

</selector>
