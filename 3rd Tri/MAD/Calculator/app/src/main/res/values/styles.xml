<resources>

    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">20sp</item>
        <item name="android:backgroundTint">#E0E0E0</item>
        <item name="android:textColor">#212121</item>
    </style>

    <style name="OperatorButton" parent="CalcButton">
        <item name="android:backgroundTint">#FF9800</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="EqualButton" parent="CalcButton">
        <item name="android:backgroundTint">#4CAF50</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="ClearButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:backgroundTint">#F44336</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

</resources>
